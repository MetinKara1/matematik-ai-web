{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "matematik-ai-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "matematik-ai.com",
      "custom_domain": true
    },
    {
      "pattern": "www.matematik-ai.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
