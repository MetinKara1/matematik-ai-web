# Optional public web configuration. These values are not passwords or API keys.
NEXT_PUBLIC_SITE_URL=https://matematik-ai.com
NEXT_PUBLIC_API_BASE_URL=https://api.matematik-ai.com
# MatAI web stream. This public ID is also the code default.
# An explicitly empty override disables analytics. Rebuild after changing.
